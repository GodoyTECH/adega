generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }

enum Role { admin manager cashier }
enum ProductType { simple composite }
enum CashStatus { open closed }
enum SaleStatus { concluded canceled reversed pending }
enum PaymentMethod { cash pix debit credit other }
enum MovementType { entry sale sale_composite manual_adjustment loss breakage expired returned sale_cancel }

model User { id String @id @default(cuid()) name String email String @unique passwordHash String role Role active Boolean @default(true) createdAt DateTime @default(now()) updatedAt DateTime @updatedAt sales Sale[] stockMovements StockMovement[] cashSessions CashSession[] }
model Store { id String @id @default(cuid()) name String document String? phone String? address String? active Boolean @default(true) createdAt DateTime @default(now()) updatedAt DateTime @updatedAt categories Category[] products Product[] sales Sale[] }
model Category { id String @id @default(cuid()) storeId String name String description String? active Boolean @default(true) createdAt DateTime @default(now()) updatedAt DateTime @updatedAt store Store @relation(fields:[storeId],references:[id]) products Product[] @@unique([storeId,name]) }
model Product { id String @id @default(cuid()) storeId String categoryId String name String barcode String? productType ProductType costPrice Decimal @db.Decimal(10,2) salePrice Decimal @db.Decimal(10,2) marginPercentage Decimal @db.Decimal(10,2) stockQuantity Decimal @db.Decimal(10,3) minStock Decimal @db.Decimal(10,3) unitType String imageUrl String? description String? preparationInstructions String? preparationTimeMinutes Int? internalNotes String? active Boolean @default(true) createdAt DateTime @default(now()) updatedAt DateTime @updatedAt store Store @relation(fields:[storeId],references:[id]) category Category @relation(fields:[categoryId],references:[id]) compositeItems CompositeProductItem[] @relation("Composite") ingredientOf CompositeProductItem[] @relation("Ingredient") saleItems SaleItem[] stockMovements StockMovement[] @@unique([storeId,barcode]) }
model CompositeProductItem { id String @id @default(cuid()) compositeProductId String ingredientProductId String quantityUsed Decimal @db.Decimal(10,3) unitType String notes String? createdAt DateTime @default(now()) updatedAt DateTime @updatedAt compositeProduct Product @relation("Composite", fields:[compositeProductId],references:[id]) ingredientProduct Product @relation("Ingredient", fields:[ingredientProductId],references:[id]) }
model Sale { id String @id @default(cuid()) storeId String userId String cashSessionId String? subtotal Decimal @db.Decimal(10,2) discount Decimal @db.Decimal(10,2) total Decimal @db.Decimal(10,2) status SaleStatus cancellationReason String? createdAt DateTime @default(now()) updatedAt DateTime @updatedAt store Store @relation(fields:[storeId],references:[id]) user User @relation(fields:[userId],references:[id]) cashSession CashSession? @relation(fields:[cashSessionId],references:[id]) items SaleItem[] payments Payment[] stockMovements StockMovement[] }
model SaleItem { id String @id @default(cuid()) saleId String productId String productNameSnapshot String quantity Decimal @db.Decimal(10,3) unitPrice Decimal @db.Decimal(10,2) total Decimal @db.Decimal(10,2) createdAt DateTime @default(now()) sale Sale @relation(fields:[saleId],references:[id]) product Product @relation(fields:[productId],references:[id]) }
model Payment { id String @id @default(cuid()) saleId String method PaymentMethod amount Decimal @db.Decimal(10,2) status String createdAt DateTime @default(now()) sale Sale @relation(fields:[saleId],references:[id]) }
model CashSession { id String @id @default(cuid()) storeId String userId String openingAmount Decimal @db.Decimal(10,2) expectedAmount Decimal @db.Decimal(10,2) closingAmount Decimal? @db.Decimal(10,2) status CashStatus openedAt DateTime @default(now()) closedAt DateTime? user User @relation(fields:[userId],references:[id]) sales Sale[] cashMovements CashMovement[] }
model CashMovement { id String @id @default(cuid()) cashSessionId String userId String type String amount Decimal @db.Decimal(10,2) reason String? createdAt DateTime @default(now()) cashSession CashSession @relation(fields:[cashSessionId],references:[id]) }
model StockMovement { id String @id @default(cuid()) storeId String productId String userId String saleId String? type MovementType quantity Decimal @db.Decimal(10,3) previousQuantity Decimal @db.Decimal(10,3) newQuantity Decimal @db.Decimal(10,3) reason String? createdAt DateTime @default(now()) product Product @relation(fields:[productId],references:[id]) user User @relation(fields:[userId],references:[id]) sale Sale? @relation(fields:[saleId],references:[id]) }
